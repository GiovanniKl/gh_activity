# Classic personal access token with `repo` and `read:org` scopes.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: override the GitHub username to sync activity for.
# If unset, it is auto-detected from the token via GET /user.
GITHUB_USERNAME=

# Default lookback window (in days) used on the very first sync.
DEFAULT_LOOKBACK_DAYS=365
